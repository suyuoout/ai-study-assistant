# 复制为 .env 再填真实值（.env 已在 .gitignore 中，不会提交）
DB_PASSWORD=change-me-strong-password

# 登录令牌签名密钥
JWT_SECRET=change-me-to-a-long-random-string
# 个人 AI Key 的加密密钥（必须与 JWT_SECRET 不同）
CRYPTO_KEY=change-me-to-another-long-random-string

# 系统默认的大模型 Key
DEEPSEEK_API_KEY=sk-your-key

# 生产环境建议关闭开放注册
ALLOW_REGISTER=false
# 每用户每天使用系统 Key 调用 AI 的次数上限（0 表示不限制）
AI_DAILY_LIMIT=50

# 初始管理员：首次部署时设为 true，创建完成后建议改回 false
BOOTSTRAP_ADMIN=false
ADMIN_USERNAME=admin
# 不填则随机生成，并打印在服务启动日志里
ADMIN_PASSWORD=

# 可选：模型与超时
# AI_MODEL=deepseek-chat
# AI_TEMPERATURE=0.7
# AI_MAX_TOKENS=2048
# AI_READ_TIMEOUT=120

# 可选：登录失败限制
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_MINUTES=10
